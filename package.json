{
  "name": "deadlock-counter-advisor",
  "productName": "Deadlock Counter Advisor",
  "version": "0.7.1",
  "private": true,
  "description": "Deadlock second-screen companion with user-approved GitHub Release update checks. Manual gameplay data only; live Overwolf integration pending approval.",
  "main": "desktop/main.cjs",
  "scripts": {
    "start": "electron .",
    "test": "node tests/run-tests.cjs && node tests/v06-tests.cjs && node tests/adapter-tests.cjs && node tests/layout-tests.cjs && node tests/v062-visual-tests.cjs && node tests/updater-tests.cjs && node tests/release-tests.cjs && node tests/catalog-fixture-tests.cjs",
    "fixture:update": "node tests/update-catalog-fixture.cjs",
    "build:win": "electron-packager . \"Deadlock Counter Advisor\" --platform=win32 --arch=x64 --asar --icon=assets/icon.ico --out=release --overwrite --ignore=^/release$ --ignore=^/tests$ --ignore=^/preview.png$ --ignore=^/README.md$",
    "build:win:portable": "electron-builder --win portable --x64 --publish never",
    "build:win:installer": "electron-builder --win nsis --x64 --publish never",
    "release:win": "electron-builder --win nsis --x64 --publish always"
  },
  "devDependencies": {
    "electron": "44.8.0",
    "@electron/packager": "20.3.0",
    "electron-builder": "26.0.12"
  },
  "build": {
    "appId": "com.deadlockcounteradvisor.desktop",
    "productName": "Deadlock Counter Advisor",
    "copyright": "Independent community prototype",
    "asar": true,
    "npmRebuild": false,
    "directories": {
      "output": "dist"
    },
    "files": [
      "index.html",
      "base.css",
      "desktop.css",
      "package.json",
      "desktop/**/*",
      "js/**/*",
      "assets/**/*",
      "!**/tests/**",
      "!**/node_modules/.cache/**",
      "!**/preview*.png",
      "!**/*.md",
      "live/**/*"
    ],
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        "nsis"
      ],
      "artifactName": "Deadlock-Counter-Advisor-Setup-${version}.${ext}",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Deadlock Counter Advisor",
      "deleteAppDataOnUninstall": false
    },
    "publish": {
      "provider": "github",
      "owner": "awkwardcarl",
      "repo": "deadlockcounteradvisor",
      "releaseType": "draft"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/awkwardcarl/deadlockcounteradvisor.git"
  },
  "homepage": "https://github.com/awkwardcarl/deadlockcounteradvisor",
  "dependencies": {
    "electron-updater": "6.8.10"
  }
}
