{
  "name": "deadlock-counter-advisor",
  "productName": "Deadlock Counter Advisor",
  "author": "Deadlock Counter Advisor",
  "version": "0.13.0",
  "private": true,
  "license": "UNLICENSED",
  "description": "Deadlock second-screen companion that suggests items to counter the enemy team. Manual entry, plus live match data (enemy heroes and their items, your hero, souls and items) in the Overwolf edition.",
  "main": "desktop/main.cjs",
  "overwolf": {
    "packages": [
      "gep"
    ]
  },
  "scripts": {
    "start": "electron .",
    "start:overwolf": "ow-electron .",
    "start:overwolf:test-ads": "ow-electron . --test-ad",
    "test": "node tests/run-tests.cjs && node tests/v06-tests.cjs && node tests/adapter-tests.cjs && node tests/layout-tests.cjs && node tests/v062-visual-tests.cjs && node tests/updater-tests.cjs && node tests/release-tests.cjs && node tests/catalog-fixture-tests.cjs && node tests/live-feed-tests.cjs && node tests/insight-tests.cjs && node tests/process-detection-tests.cjs && node tests/debrief-tests.cjs && node tests/overwolf-live-tests.cjs && node tests/companion-tests.cjs && node tests/match-view-tests.cjs && node tests/phase-build-tests.cjs && node tests/team-tests.cjs && node tests/build-data-tests.cjs && node tests/investment-glance-tests.cjs && node tests/early-picks-tests.cjs && node tests/dusk-theme-tests.cjs && node tests/game-data-tests.cjs && node tests/ads-tests.cjs",
    "fixture:update": "node tests/update-catalog-fixture.cjs",
    "fixture:match": "node tests/update-match-fixture.cjs",
    "build:win": "electron-packager . \"Deadlock Counter Advisor\" --platform=win32 --arch=x64 --asar --icon=assets/icon.ico --out=release --overwrite --ignore=^/release$ --ignore=^/tests$ --ignore=^/preview.png$ --ignore=^/README.md$",
    "build:win:portable": "electron-builder --win portable --x64 --publish never",
    "build:win:installer": "electron-builder --win nsis --x64 --publish never",
    "release:win": "electron-builder --win nsis --x64 --publish always",
    "build:overwolf": "ow-electron-builder --config electron-builder.overwolf.cjs --win nsis --x64 --publish never"
  },
  "devDependencies": {
    "@electron/packager": "20.3.0",
    "@overwolf/ow-electron": "42.11.4",
    "@overwolf/ow-electron-builder": "26.9.3",
    "electron": "44.8.0",
    "electron-builder": "26.0.12"
  },
  "build": {
    "appId": "com.deadlockcounteradvisor.desktop",
    "productName": "Deadlock Counter Advisor",
    "copyright": "Independent community prototype",
    "asar": true,
    "npmRebuild": false,
    "directories": {
      "output": "dist"
    },
    "files": [
      "index.html",
      "dusk.css",
      "base.css",
      "desktop.css",
      "package.json",
      "desktop/**/*",
      "js/**/*",
      "assets/**/*",
      "!**/tests/**",
      "!**/node_modules/.cache/**",
      "!**/preview*.png",
      "!**/*.md",
      "live/**/*"
    ],
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        "nsis"
      ],
      "artifactName": "Deadlock-Counter-Advisor-Setup-${version}.${ext}",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Deadlock Counter Advisor",
      "deleteAppDataOnUninstall": false,
      "license": "installer/license.txt"
    },
    "publish": {
      "provider": "github",
      "owner": "awkwardcarl",
      "repo": "deadlockcounteradvisor",
      "releaseType": "draft"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/awkwardcarl/deadlockcounteradvisor.git"
  },
  "homepage": "https://github.com/awkwardcarl/deadlockcounteradvisor",
  "dependencies": {
    "electron-updater": "6.8.10"
  }
}
